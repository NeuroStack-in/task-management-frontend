# WorkPulse frontend — required environment.
# Copy to `.env.local` and fill in from the backend deploy outputs:
#   cd ../backend/infra && cdk deploy -c env=dev --all --profile <profile>
# → HttpApiUrl, UserPoolId, UserPoolClientId.
#
# All NEXT_PUBLIC_* values are exposed to the browser. That's correct here: the API URL and the
# Cognito pool/client ids are public identifiers, not secrets (auth is proven by the SRP exchange).

# Base URL of the backend HTTP API (no trailing slash).
NEXT_PUBLIC_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# Region the Cognito pool lives in.
NEXT_PUBLIC_AWS_REGION=<region>

# Cognito user pool + SPA app client (the client must allow the SRP auth flow).
NEXT_PUBLIC_COGNITO_USER_POOL_ID=<region>_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
